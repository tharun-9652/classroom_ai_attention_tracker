# Production configuration. Copy to a protected deployment secret store; never
# commit a populated .env.production file.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-app.example
DJANGO_PUBLIC_URL=https://your-app.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.example
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_ADMIN_USERNAME=replace-with-an-unique-admin-name
DJANGO_ADMIN_PASSWORD=replace-with-a-strong-unique-password
DJANGO_ADMIN_EMAIL=admin@your-app.example
DATABASE_URL=postgresql://user:password@host:5432/classroom_attention
REDIS_URL=redis://host:6379/0
# Vercel sets this automatically; retain it when reproducing production locally.
VERCEL=1
